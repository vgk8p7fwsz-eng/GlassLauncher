<?xml version="1.0" encoding="utf-8"?>
<!--
  canRequestFilterKeyEvents + flagRequestFilterKeyEvents: служба получает KeyEvent раньше системы
  (Home, кнопки приложений на пульте, громкость).
  typeWindowStateChanged: видим, когда на передний план выходит стоковый лаунчер.
  Содержимое окон не читаем (canRetrieveWindowContent=false) - достаточно packageName/className события.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_description"
    android:notificationTimeout="80"
    android:settingsActivity="dev.glasslauncher.tv.ui.MainActivity" />
